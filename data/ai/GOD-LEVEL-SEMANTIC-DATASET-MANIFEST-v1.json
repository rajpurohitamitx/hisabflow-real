{
  "name": "Hisab Flow GOD-Level Semantic Conversation Dataset v1",
  "version": "1.0",
  "purpose": "Semantic few-shot, regression, conversation-state, safety and business-analysis reference corpus.",
  "not_model_training": true,
  "families": [
    "CUSTOMER",
    "CUSTOMER_CREATE",
    "CUSTOMER_DETAILS",
    "CUSTOMER_STATEMENT",
    "RECEIVE_PAYMENT",
    "PAYMENT_ALLOCATION",
    "ADVANCE_PAYMENT",
    "SETTLE_OUTSTANDING",
    "CREATE_SALE",
    "CREATE_PURCHASE",
    "PRODUCT_SEARCH",
    "PRODUCT_PRICE",
    "QUANTITY_MONEY_CONVERSION",
    "UNIT_MEMORY",
    "INVENTORY",
    "STOCK_TRANSFER",
    "RETURN",
    "REFUND",
    "EXPENSE",
    "REMINDER",
    "DATE_TIME",
    "RESULT_FOLLOWUP",
    "CONTEXT",
    "CORRECTION",
    "ENTITY_RESOLUTION",
    "MULTILINGUAL",
    "CONFIRMATION",
    "CANCELLATION",
    "UNDO",
    "DESTRUCTIVE_SAFETY",
    "AUDIT",
    "BUSINESS_MEMORY",
    "BUSINESS_BRIEFING",
    "SALES_ANALYSIS",
    "PROFIT_ANALYSIS",
    "CASH_FLOW",
    "INVENTORY_ANALYSIS",
    "SUPPLIER_ANALYSIS",
    "CUSTOMER_ANALYSIS",
    "FORECAST",
    "ANOMALY",
    "ROOT_CAUSE",
    "RECOMMENDATION",
    "SECURITY",
    "AI_ACTION_HISTORY"
  ],
  "state_machine": [
    "NEW_REQUEST",
    "READ_ONLY",
    "WAITING_INPUT",
    "WAITING_CONFIRMATION",
    "PATCH_PENDING",
    "CONFIRM_PENDING",
    "CANCEL_PENDING",
    "EXECUTING",
    "EXECUTED",
    "FAILED",
    "EXPIRED"
  ],
  "critical_invariants": [
    "explicit_current_entity_overrides_stale_context",
    "never_merge_mismatched_entity_name_and_id",
    "payment_is_not_sale",
    "read_only_queries_do_not_require_confirmation",
    "yes_executes_only_current_pending_confirmation",
    "confirmation_is_idempotent",
    "corrections_patch_pending_action",
    "never_invent_financial_amounts",
    "never_fabricate_prices",
    "never_destructively_delete_accounting_history",
    "analytics_are_grounded_in_actual_records",
    "recommendations_do_not_execute_automatically",
    "business_memory_requires_explicit_or_strong_evidence",
    "context_isolation_between_unrelated_requests"
  ],
  "recommended_use": [
    "few-shot semantic prompting",
    "retrieval examples",
    "golden regression tests",
    "conversation-state tests",
    "entity-resolution tests",
    "analytics explanation tests",
    "safety tests"
  ]
}

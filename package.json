{
  "name": "hisabflow-production",
  "version": "3.1.0",
  "private": true,
  "description": "Hisab Flow \u2014 AI-native business operating system for Indian businesses.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "check": "tsc --noEmit",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test:architecture": "node scripts/validate-architecture.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "ci": "npm run test:architecture && npm run check && npm run build",
    "test:e2e": "playwright test",
    "test:db": "tsx scripts/smoke-db.ts",
    "test:openai": "node scripts/smoke-openai.mjs",
    "validate:ultra-voice": "node scripts/validate-ultra-voice.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "openai": "^6.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=22.16.0 <25.0.0"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}

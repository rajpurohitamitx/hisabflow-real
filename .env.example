DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hisabflow?sslmode=require"
SESSION_SECRET="generate-a-long-random-32-plus-character-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI / Voice (optional for local deterministic mode; required for full multilingual voice)
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-5"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_VOICE="marin"

# Set to "off" to force browser SpeechRecognition instead of audio upload.
NEXT_PUBLIC_VOICE_CAPTURE="on"

# Optional integrations to enable later
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
REDIS_URL=""
SENTRY_DSN=""
